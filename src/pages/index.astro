---
import Layout from '@/layouts/Layout.astro';
import Search from 'astro-pagefind/components/Search';
import HomepageMasonry from '@/components/HomepageMasonry';
import HomepageEditor from '@/components/HomepageEditor';
import homepageConfig from '@/data/homepage-tiles.json';
import { getHomepageCatalog, resolveHomepageTiles } from '@/utils/homepage';

const catalog = await getHomepageCatalog();
const { config, tiles } = resolveHomepageTiles(homepageConfig, catalog);
const isDev = import.meta.env.DEV;
---

<Layout
  title="Otibeguni | Reviving Bengali and Indigenous Folklore"
  description="We preserve, adapt, and share the rich cultural heritage of our oral traditions through books, archives, and storytelling projects built for modern audiences."
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <section class="max-w-4xl space-y-6">
      <div class="space-y-3">
        <h1 class="max-w-4xl text-4xl font-bold leading-tight text-slate-900 sm:text-5xl">
          Reviving Bengali and Indigenous Folklore
        </h1>
        <p class="max-w-3xl text-base leading-7 text-slate-600 sm:text-lg">
          We preserve, adapt, and share the rich cultural heritage of our oral traditions
          through books, archives, and storytelling projects built for modern audiences.
        </p>
      </div>

      <div>
        <Search id="search" className="pagefind-ui mb-8" uiOptions={{ showImages: false }} />
      </div>
    </section>

    <section class="mt-10" aria-label="Featured folklore and publications">
      {
        isDev ? (
          <HomepageEditor
            initialConfig={config}
            initialTiles={tiles}
            catalog={catalog}
            client:load
          />
        ) : (
          <HomepageMasonry tiles={tiles} client:load />
        )
      }
    </section>
  </div>
</Layout>
